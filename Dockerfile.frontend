# Multi-stage Dockerfile for TraclyTag Frontend Web UI
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

WORKDIR /app

# Stage 1: Build Frontend Bundle
FROM base AS builder

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/db/package.json ./lib/db/
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/traclytag/package.json ./artifacts/traclytag/
COPY scripts/package.json ./scripts/

RUN pnpm install --no-frozen-lockfile

COPY lib/ ./lib/
COPY artifacts/traclytag/ ./artifacts/traclytag/

RUN find . -name "*.tsbuildinfo" -delete
RUN pnpm --filter @workspace/traclytag run build

# Stage 2: Nginx Web Server
FROM nginx:alpine AS runner

# Copy built frontend assets
COPY --from=builder /app/artifacts/traclytag/dist /usr/share/nginx/html

# Copy custom Nginx configuration with reverse proxy for /api
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
